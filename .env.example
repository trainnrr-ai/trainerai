DATABASE_DRIVER=mongodb
NEXT_PUBLIC_AUTH_PROVIDER=emergent
MONGO_URL=mongodb://localhost:27017
DB_NAME=spottr

# Set DATABASE_DRIVER=firebase in production to store users, sessions, profiles,
# chats, matches, requests, reports and admin data in Google Firebase Firestore.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON in hosting secrets.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-project-id","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Or use the split form:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Google Auth client config. Set NEXT_PUBLIC_AUTH_PROVIDER=firebase
# after enabling Google sign-in in Firebase Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

NEXT_PUBLIC_BASE_URL=https://trainr.in
CORS_ORIGINS=https://trainr.in
